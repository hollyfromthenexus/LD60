; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="LD60"
run/main_scene="uid://c5uqc6qe5hs5r"
config/features=PackedStringArray("4.8", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Services="*uid://bbj8d0qj7fgog"
DovedraftConfigService="*uid://brrpom1dk5367"
GameSaveService="*uid://8r3c7kdecox7"
WorldService="*uid://cwhv0q48nhfvd"
MapService="*uid://c0m6rbi6j4iej"
Dialog="*uid://4n8n72sap3ev"
CameraService="*uid://ci6kbyg1yakgl"
HUD="*uid://bk75mubxovxck"
MouseLock="*uid://cgvu3pe1tcdjn"
PlayerService="*uid://c8stmq6jpgh0q"
SettingsService="*uid://bv3ydp7u1a0rv"
LoadingScreenService="*uid://cmtlt0y7itrmv"
AppService="*uid://cusg5yph0jp5v"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="LD60"

[editor_plugins]

enabled=PackedStringArray("res://addons/DoveDraft/plugin.cfg", "res://addons/YarnSpinner-Godot/plugin.cfg")

